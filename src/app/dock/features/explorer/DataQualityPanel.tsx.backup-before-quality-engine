function Metric({

  label,

  value,

  detail,

}: {

  label: string;

  value: string;

  detail?: string;

}) {

  return (

    <div style={styles.metric}>

      <span style={styles.metricLabel}>{label}</span>

      <strong style={styles.metricValue}>{value}</strong>

      {detail ? (

        <small style={styles.metricDetail}>{detail}</small>

      ) : null}

    </div>

  );

}



function IssueRow({

  label,

  detail,

  value,

  onClick,

  last = false,

}: {

  label: string;

  detail: string;

  value: string;

  onClick: () => void;

  last?: boolean;

}) {

  return (

    <button

      type="button"

      onClick={onClick}

      style={{

        ...styles.issueRow,

        ...(last ? { borderBottom: 0 } : {}),

      }}

      onMouseEnter={(event) => {

        event.currentTarget.style.background =

          "rgba(255,255,255,0.045)";

      }}

      onMouseLeave={(event) => {

        event.currentTarget.style.background = "transparent";

      }}

    >

      <span style={{ flex: 1, minWidth: 0 }}>

        <span style={styles.issueLabel}>{label}</span>

        <span style={styles.issueHint}>{detail}</span>

      </span>



      <strong style={styles.issueCount}>{value}</strong>



      <ChevronRight

        size={13}

        aria-hidden="true"

        color="#a3a3a3"

      />

    </button>

  );

}



export default function DataQualityPanel({

  dataset,

  onNavigateToTool,

}: DataQualityPanelProps) {

  const [activeTab, setActiveTab] =

    useState<QualityTab>("Overview");



  const handleNavigateToTool = (tool: QualityAction) => {

    if (typeof onNavigateToTool === "function") {

      onNavigateToTool(tool);

      return;

    }



    console.error(

      `[DataQualityPanel] Cannot open "${tool}" because the parent did not provide onNavigateToTool.`,

    );

  };



  if (!dataset?.summary) {

    return (

      <section style={styles.panel}>

        <div style={styles.header}>

          <div>

            <h3 style={styles.headerTitle}>Data quality</h3>

            <p style={styles.muted}>Dataset health checks</p>

          </div>



          <Database size={16} aria-hidden="true" />

        </div>



        <div style={styles.empty}>

          <Database size={17} aria-hidden="true" />

          <span>

            Import a dataset to calculate data quality.

          </span>

        </div>

      </section>

    );

  }



  // Read current rows from the registry instead of relying on the imported
  // dataset summary, which may be stale after cleaning operations.
  const columnNames = dataset.columns.map((column) =>
    typeof column === "string" ? column : column.name
  );
  const rows = datasetRegistry.getRows(dataset.id) ?? [];
  const rowCount = rows.length;
  const columnCount = columnNames.length;
  const missingCells = rows.reduce((total, row) =>
    total + columnNames.filter((column) => {
      const value = row[column];
      return value === null || value === undefined ||
        (typeof value === "string" && value.trim() === "");
    }).length, 0
  );
  const seenRows = new Set<string>();
  let duplicateRows = 0;
  for (const row of rows) {
    const signature = JSON.stringify(columnNames.map((column) => row[column] ?? null));
    if (seenRows.has(signature)) duplicateRows += 1;
    else seenRows.add(signature);
  }
  const summary = { rowCount, columnCount, missingCells, duplicateRows };
  const totalCells = rowCount * columnCount;
  const missingPercent = totalCells > 0 ? (missingCells / totalCells) * 100 : 0;
  const duplicatePercent = rowCount > 0 ? (duplicateRows / rowCount) * 100 : 0;
  const columnsWithMissing = columnNames.filter((column) =>
    rows.some((row) => {
      const value = row[column];
      return value === null || value === undefined ||
        (typeof value === "string" && value.trim() === "");
    })
  ).length;



  const score = Math.max(

    0,

    Math.round(

      100 -

        Math.min(70, missingPercent * 2) -

        Math.min(30, duplicatePercent * 3),

    ),

  );



  const qualityTier =

    score >= 95

      ? "Excellent"

      : score >= 85

        ? "Strong"

        : score >= 70

          ? "Fair"

          : "Needs review";



  const isHealthy =

    summary.missingCells === 0 &&

    summary.duplicateRows === 0;



  const tabNames: QualityTab[] = [

    "Overview",

    "Issues",

    "Columns",

  ];



  return (

    <section style={styles.panel}>

      <div style={styles.header}>

        <div>

          <h3 style={styles.headerTitle}>Data quality</h3>

          <p style={styles.muted}>

            Compact dataset profile and diagnostics

          </p>

        </div>



        <ShieldCheck

          size={16}

          style={styles.headerIcon}

          aria-hidden="true"

        />

      </div>



      <div

        role="tablist"

        aria-label="Data quality sections"

        style={styles.tabs}

      >

        {tabNames.map((tab) => {

          const selected = activeTab === tab;



          return (

            <button

              key={tab}

              type="button"

              role="tab"

              aria-selected={selected}

              onClick={() => setActiveTab(tab)}

              style={{

                ...styles.tab,

                ...(selected ? styles.activeTab : {}),

              }}

            >

              {tab}

            </button>

          );

        })}

      </div>



      <div style={styles.content}>

        {activeTab === "Overview" && (

          <>

            <div

              className="dock-quality-compact-metrics"

              style={styles.metrics}

            >

              <Metric

                label="Rows"

                value={summary.rowCount.toLocaleString()}

              />



              <Metric

                label="Columns"

                value={summary.columnCount.toLocaleString()}

              />



              <Metric

                label="Missing cells"

                value={summary.missingCells.toLocaleString()}

                detail={`${missingPercent.toFixed(1)}% of cells`}

              />



              <Metric

                label="Duplicate rows"

                value={summary.duplicateRows.toLocaleString()}

                detail={`${duplicatePercent.toFixed(1)}% of rows`}

              />

            </div>



            <div style={styles.scoreCard}>

              <div style={styles.scoreHeader}>

                <div>

                  <h4

                    style={styles.scoreTitle}

                    title="Score = 100 − up to 70 points for missing cells − up to 30 points for duplicate rows."

                  >

                    Quality score

                  </h4>



                  <p style={styles.muted}>

                    Based on missing cells and duplicate rows

                  </p>

                </div>



                <strong style={styles.scoreValue}>

                  {score}

                  <span

                    style={{

                      color: "#a3a3a3",

                      fontSize: 11,

                      fontWeight: 500,

                    }}

                  >

                    /100

                  </span>

                </strong>

              </div>



              <div

                style={styles.progressTrack}

                role="progressbar"

                aria-label="Data quality score"

                aria-valuemin={0}

                aria-valuemax={100}

                aria-valuenow={score}

              >

                <div

                  style={{

                    ...styles.progressFill,

                    width: `${score}%`,

                  }}

                />

              </div>



              <div style={styles.scoreFooter}>

                <span

                  style={{

                    color: "#e5e5e5",

                    fontWeight: 600,

                  }}

                >

                  {qualityTier}

                </span>



                <span>

                  {totalCells.toLocaleString()} total cells

                </span>

              </div>

            </div>



            <div style={styles.note}>

              {isHealthy ? (

                <CheckCircle2

                  size={14}

                  color="#d4d4d4"

                  aria-hidden="true"

                />

              ) : (

                <AlertTriangle

                  size={14}

                  color="#d4d4d4"

                  aria-hidden="true"

                />

              )}



              <p style={styles.noteText}>

                {isHealthy

                  ? "No missing cells or duplicate rows detected."

                  : "Review missing values and duplicate records before analysis. Select Issues for quick access to cleaning tools."}

              </p>

            </div>

          </>

        )}



        {activeTab === "Issues" && (

          <>

            <div

              style={{

                ...styles.scoreFooter,

                margin: "0 1px 8px",

              }}

            >

              <span style={styles.sectionTitle}>

                Detected issues

              </span>



              <span style={styles.status}>

                {isHealthy

                  ? "No detected issues"

                  : "Review recommended"}

              </span>

            </div>



            <div style={styles.issueList}>

              <IssueRow

                label="Columns with missing values"

                detail="Open missing-value management"

                value={columnsWithMissing.toLocaleString()}

                onClick={() =>

                  handleNavigateToTool("missing-values")

                }

              />



              <IssueRow

                label="Missing cells"

                detail="Inspect and replace missing values"

                value={summary.missingCells.toLocaleString()}

                onClick={() =>

                  handleNavigateToTool("missing-values")

                }

              />



              <IssueRow

                label="Duplicate records"

                detail="Review and remove duplicate rows"

                value={summary.duplicateRows.toLocaleString()}

                onClick={() =>

                  handleNavigateToTool("duplicate-rows")

                }

                last

              />

            </div>



            <p style={{ ...styles.muted, marginTop: 8 }}>

              Select an issue to open its cleaning tool.

            </p>

          </>

        )}



        {activeTab === "Columns" && (

          <div style={{ margin: "0 -10px -10px" }}>

            <ColumnQualityInspection

              key={dataset.id}

              dataset={dataset}

              onNavigateToTool={handleNavigateToTool}

            />

          </div>

        )}

      </div>



      <p

        style={{

          margin: 0,

          padding: "8px 11px",

          borderTop: "1px solid #414141",

          color: "#8f8f8f",

          fontSize: 9,

          lineHeight: 1.45,

        }}

      >

        Quality score is a heuristic based on missing cells and

        duplicate rows; it does not measure overall data accuracy

        or suitability for every analysis.

      </p>



      <style>{`

        @media (max-width: 520px) {

          .dock-quality-compact-metrics {

            grid-template-columns: repeat(2, minmax(0, 1fr));

          }

        }



        @media (prefers-reduced-motion: reduce) {

          * {

            transition-duration: 0.01ms !important;

          }

        }

      `}</style>

    </section>

  );

}
