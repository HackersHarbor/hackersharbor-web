.workspace {

    --bg: #1e1e1e;
  
    --panel: #252526;
  
    --panel-raised: #2d2d2d;
  
    --panel-hover: #333333;
  
    --border: #383838;
  
    --border-strong: #505050;
  
    --text: #f1f1f1;
  
    --muted: #b4b4b4;
  
    --subtle: #858585;
  
    --accent: #29b77a;
  
    --accent-soft: rgba(41, 183, 122, .12);
  
    display: flex;
  
    flex-direction: column;
  
    width: 100%;
  
    height: calc(100vh - 0px);
  
    min-height: 640px;
  
    overflow: hidden;
  
    color: var(--text);
  
    background: var(--bg);
  
    font: 12px/1.4 Inter, "Segoe UI", Arial, sans-serif;
  
  }
  
  .workspace, .workspace \* { box-sizing: border-box; }
  
  .workspace button, .workspace input, .workspace select, .workspace textarea { font: inherit; }
  
  .workspace button { color: inherit; cursor: pointer; }
  
  .workspace button:disabled { opacity: .45; cursor: not-allowed; }
  
  .workspace button:focus-visible, .workspace input:focus-visible, .workspace select:focus-visible, .workspace textarea:focus-visible { outline: 1px solid var(--accent); outline-offset: 1px; }
  
  .topbar, .toolbar, .statusbar { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
  
  .topbar { height:42px; padding:0 12px; border-bottom:1px solid var(--border); background:var(--panel); }
  
  .brand, .topActions, .brand > div, .toolbarGroup, .toolbarButton, .quietButton, .engineStatus, .editorTitle, .editorTools, .resultTabs, .resultActions, .statusRight, .statusRight span { display:flex; align-items:center; }
  
  .brand { gap:9px; min-width:0; }
  
  .brandMark { display:grid; place-items:center; width:26px; height:26px; border:1px solid #454545; border-radius:4px; background:#303030; color:#e5e5e5; }
  
  .brand > div { align-items:flex-start; flex-direction:column; gap:0; }
  
  .brand strong { font-size:12px; font-weight:700; line-height:1.1; }
  
  .brand > div span { color:var(--subtle); font-size:8px; font-weight:700; letter-spacing:1.15px; }
  
  .divider, .toolbarDivider { width:1px; height:20px; margin:0 4px; background:var(--border-strong); }
  
  .breadcrumb { color:#d0d0d0; white-space:nowrap; }
  
  .topActions { gap:12px; }
  
  .engineStatus { gap:5px; color:var(--subtle); font-size:10px; white-space:nowrap; }
  
  .engineStatus > span, .statusDot { width:6px; height:6px; border-radius:50%; background:#777; }
  
  .engineStatus.ready > span, .statusDot { background:var(--accent); }
  
  .iconButton { display:inline-grid; place-items:center; width:25px; height:25px; border:1px solid transparent; border-radius:3px; color:var(--muted); background:transparent; }
  
  .iconButton:hover { border-color:var(--border-strong); background:var(--panel-hover); color:var(--text); }
  
  .toolbar { min-height:39px; padding:4px 10px; gap:10px; border-bottom:1px solid var(--border); background:#222; }
  
  .toolbarGroup { gap:7px; min-width:0; }
  
  .toolbarButton, .quietButton { justify-content:center; gap:6px; min-height:26px; padding:0 9px; border:1px solid var(--border-strong); border-radius:3px; background:var(--panel-raised); white-space:nowrap; }
  
  .toolbarButton:hover, .quietButton:hover { background:var(--panel-hover); }
  
  .toolbarButton:first-child { border-color:#267a55; background:rgba(41,183,122,.13); color:#e9fff5; }
  
  .toolbarLabel { color:var(--subtle); font-size:10px; }
  
  .select, .limitSelect { max-width:190px; height:26px; padding:0 7px; border:1px solid var(--border); border-radius:3px; color:var(--text); background:#202020; }
  
  .limitSelect { width:72px; }
  
  .quietButton { min-height:25px; border-color:transparent; background:transparent; color:var(--muted); }
  
  .body { display:flex; flex:1; min-height:0; overflow:hidden; }
  
  .rail { display:flex; flex:0 0 39px; flex-direction:column; align-items:center; gap:5px; padding:8px 5px; border-right:1px solid var(--border); background:#202020; }
  
  .railButton { display:grid; place-items:center; width:29px; height:30px; border:1px solid transparent; border-radius:4px; color:#9c9c9c; background:transparent; }
  
  .railButton:hover, .railActive { color:#f0f0f0; border-color:#454545; background:#303030; }
  
  .railActive { box-shadow:inset 2px 0 var(--accent); }
  
  .railSpacer { flex:1; }
  
  .explorer { display:flex; flex:0 0 250px; flex-direction:column; min-width:190px; border-right:1px solid var(--border); background:#222; overflow:hidden; }
  
  .panelHeading { display:flex; align-items:center; justify-content:space-between; height:34px; padding:0 9px 0 12px; color:#aaa; font-size:10px; font-weight:700; letter-spacing:.7px; border-bottom:1px solid #303030; }
  
  .searchWrap { display:flex; align-items:center; gap:7px; height:29px; margin:7px 8px; padding:0 7px; color:#858585; border:1px solid #3b3b3b; border-radius:3px; background:#1e1e1e; }
  
  .searchWrap input { width:100%; min-width:0; border:0; outline:0; color:var(--text); background:transparent; font-size:11px; }
  
  .tree { flex:1; min-height:0; overflow:auto; padding:0 5px 10px; }
  
  .treeHeading, .treeItem, .columnNode { display:flex; align-items:center; width:100%; min-height:25px; gap:6px; padding:0 6px; text-align:left; border:0; border-radius:3px; color:#c8c8c8; background:transparent; white-space:nowrap; }
  
  .treeHeading { margin-top:4px; color:#ddd; font-size:11px; font-weight:600; }
  
  .treeHeading > span { margin-left:auto; color:#888; font-size:10px; font-weight:400; }
  
  .treeHeading:hover, .treeItem:hover, .columnNode:hover { background:#2e2e2e; }
  
  .treeChildren { padding-left:8px; }
  
  .datasetNode { margin-top:1px; }
  
  .treeItem { min-width:0; color:#c4c4c4; overflow:hidden; }
  
  .treeItem > span:not(.rowCount) { overflow:hidden; text-overflow:ellipsis; }
  
  .treeSelected { background:#2c3530; color:#f0f0f0; }
  
  .rowCount { margin-left:auto; color:#858585; font-size:10px; }
  
  .columnsTree { padding:0 0 3px 18px; }
  
  .columnNode { min-height:22px; gap:5px; padding-right:4px; font-family:ui-monospace, SFMono-Regular, Consolas, monospace; font-size:10px; }
  
  .columnGlyph { color:#888; }
  
  .columnName { min-width:0; overflow:hidden; text-overflow:ellipsis; color:#d5d5d5; }
  
  .typeLabel { margin-left:auto; color:var(--accent); font-size:9px; letter-spacing:.15px; }
  
  .treeSection { margin-top:8px; padding-top:7px; border-top:1px solid #343434; }
  
  .treeSection .treeItem { padding-left:25px; }
  
  .treeEmpty { padding:10px 12px; color:#858585; font-size:11px; }
  
  .uploadDock { padding:8px; border-top:1px solid var(--border); }
  
  .uploadDock :global(button) { max-width:100%; }
  
  .inlineError { display:flex; align-items:center; justify-content:space-between; gap:6px; padding:7px 9px; color:#f1aaaa; border-top:1px solid #513333; font-size:10px; }
  
  .inlineError button { display:grid; place-items:center; border:0; color:inherit; background:transparent; }
  
  .mainPane { display:flex; flex:1; flex-direction:column; min-width:0; min-height:0; overflow:hidden; }
  
  .tabs { display:flex; flex-shrink:0; align-items:stretch; height:34px; overflow-x:auto; border-bottom:1px solid var(--border); background:#202020; scrollbar-width:thin; }
  
  .tab { display:flex; align-items:center; gap:7px; min-width:0; max-width:210px; padding:0 10px; color:#aaa; border-right:1px solid #303030; cursor:pointer; white-space:nowrap; }
  
  .tab > span { overflow:hidden; text-overflow:ellipsis; }
  
  .tab button { display:grid; place-items:center; width:17px; height:17px; margin-left:2px; border:0; border-radius:2px; color:#777; background:transparent; }
  
  .tab button:hover { color:#fff; background:#454545; }
  
  .activeTab { position:relative; color:#f4f4f4; background:#282828; }
  
  .activeTab::before { position:absolute; top:0; left:0; right:0; height:2px; content:""; background:var(--accent); }
  
  .tabAdd { display:grid; place-items:center; flex:0 0 30px; border:0; color:#aaa; background:transparent; }
  
  .tabAdd:hover { background:#303030; }
  
  .workspaceContent { display:flex; flex:1; flex-direction:column; min-height:0; overflow:hidden; }
  
  .editorHeader { display:flex; align-items:center; justify-content:space-between; min-height:32px; padding:0 10px; border-bottom:1px solid #303030; background:#252526; }
  
  .editorTitle { gap:7px; min-width:0; }
  
  .editorTitle strong { font-size:11px; font-weight:600; }
  
  .fileGlyph { display:grid; place-items:center; color:#bcbcbc; }
  
  .editorHint, .editorTools { color:#858585; font-size:10px; }
  
  .editorTools { gap:12px; }
  
  .editorArea { display:flex; flex:1; min-height:100px; overflow:auto; background:#1e1e1e; }
  
  .lineNumbers { display:flex; flex:0 0 40px; flex-direction:column; align-items:flex-end; padding:10px 9px 10px 0; color:#6c6c6c; border-right:1px solid #2d2d2d; user-select:none; font:12px/19px ui-monospace, SFMono-Regular, Consolas, monospace; }
  
  .codeEditor { display:block; flex:1; width:100%; min-width:0; min-height:100%; resize:none; padding:10px 12px; border:0; outline:0; color:#e0e0e0; background:transparent; tab-size:4; white-space:pre; overflow:auto; font:12px/19px ui-monospace, SFMono-Regular, Consolas, monospace !important; }
  
  .results { display:flex; flex:0 0 auto; flex-direction:column; min-height:130px; border-top:1px solid #4b4b4b; background:#202020; overflow:hidden; }
  
  .resultsHeader { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; min-height:32px; border-bottom:1px solid #333; background:#252526; }
  
  .resultTabs, .resultActions { height:100%; gap:2px; }
  
  .resultTab, .resultTabActive { display:flex; align-items:center; gap:6px; height:32px; padding:0 11px; border:0; border-bottom:2px solid transparent; color:#999; background:transparent; }
  
  .resultTabActive { color:#f1f1f1; border-bottom-color:var(--accent); }
  
  .resultActions { gap:8px; padding-right:7px; color:#888; font-size:10px; }
  
  .resultViewButton { display:flex; align-items:center; gap:4px; min-height:23px; padding:0 6px; border:1px solid transparent; border-radius:3px; color:#999; background:transparent; }
  
  .resultViewButton:hover { color:#eee; border-color:#454545; }
  
  .tableViewport { flex:1; min-height:0; overflow:auto; }
  
  .resultTable { width:100%; border-collapse:separate; border-spacing:0; font-size:11px; }
  
  .resultTable th { position:sticky; top:0; z-index:1; height:28px; padding:0 10px; text-align:left; color:#c9c9c9; font-weight:600; background:#292929; border-bottom:1px solid #444; border-right:1px solid #353535; white-space:nowrap; }
  
  .resultTable td { max-width:360px; height:24px; padding:0 10px; color:#e1e1e1; border-bottom:1px solid #303030; border-right:1px solid #303030; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-variant-numeric:tabular-nums; }
  
  .resultTable tr:hover td { background:#282828; }
  
  .emptyResults { display:flex; flex:1; min-height:120px; flex-direction:column; align-items:center; justify-content:center; gap:7px; color:#777; text-align:center; }
  
  .emptyResults strong { color:#c6c6c6; font-size:11px; font-weight:600; }
  
  .emptyResults span { font-size:10px; }
  
  .consoleOutput { flex:1; min-height:100px; margin:0; padding:12px 14px; overflow:auto; color:#d4d4d4; white-space:pre-wrap; overflow-wrap:anywhere; font:12px/1.6 ui-monospace, SFMono-Regular, Consolas, monospace; }
  
  .errorOutput { display:flex; align-items:flex-start; gap:8px; padding:9px 12px; color:#efb0b0; border-bottom:1px solid #593939; background:#2a2020; }
  
  .errorOutput pre { flex:1; margin:0; white-space:pre-wrap; overflow-wrap:anywhere; font:11px/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; }
  
  .errorOutput button { border:0; color:#efb0b0; background:transparent; }
  
  .chartPanel { flex:1; min-height:0; padding:12px; overflow:auto; }
  
  .chartPanel > label { display:inline-flex; align-items:center; gap:6px; margin:0 12px 12px 0; color:#aaa; font-size:10px; }
  
  .chartPanel select { max-width:180px; padding:4px 6px; border:1px solid #444; border-radius:3px; color:#ddd; background:#252526; }
  
  .chartBars { max-width:900px; }
  
  .chartBarRow { display:grid; grid-template-columns:minmax(90px, 160px) 1fr 90px; align-items:center; gap:10px; min-height:25px; }
  
  .chartBarRow > span { overflow:hidden; color:#c7c7c7; text-overflow:ellipsis; white-space:nowrap; }
  
  .chartBarRow > div { height:10px; overflow:hidden; background:#303030; }
  
  .chartBarRow i { display:block; height:100%; background:var(--accent); }
  
  .chartBarRow b { color:#ddd; text-align:right; font:10px ui-monospace, SFMono-Regular, Consolas, monospace; }
  
  .panelContent { flex:1; min-height:0; padding:12px; overflow:auto; }
  
  .sectionTitle { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; }
  
  .sectionTitle h2 { margin:0; font-size:15px; font-weight:650; }
  
  .sectionTitle p { margin:4px 0 0; color:#888; font-size:10px; }
  
  .statusbar { min-height:25px; padding:0 10px; gap:10px; border-top:1px solid var(--border); color:#b5b5b5; background:#252526; font-size:10px; }
  
  .statusbar > div:first-child { display:flex; align-items:center; gap:6px; }
  
  .statusSep { color:#666; }
  
  .statusRight { gap:14px; }
  
  .statusRight span { gap:5px; white-space:nowrap; color:#929292; }
  
  .statusRight svg { color:#aaa; }
  
  @media (max-width: 900px) {
  
    .explorer { flex-basis:205px; }
  
    .toolbar { align-items:flex-start; flex-wrap:wrap; }
  
    .toolbarGroup { flex-wrap:wrap; }
  
    .editorHint { display:none; }
  
    .statusRight { gap:7px; }
  
  }
  
  @media (max-width: 650px) {
  
    .explorer { flex-basis:165px; min-width:145px; }
  
    .topActions .engineStatus { display:none; }
  
    .statusRight span:nth-child(1), .statusRight span:nth-child(2) { display:none; }
  
  }
  
  
  
  */\* =========================================================*
  
  *&#xA0;  DATA EXPLORER VIEWPORT AND TAB STRIP*
  
  *&#xA0;  This component is embedded inside DockStudio, so it must fill*
  
  *&#xA0;  its parent instead of creating a second viewport-height page.*
  
  *&#xA0;  ========================================================= \*/*
  
  .workspace {
  
    display: flex;
  
    flex: 1 1 0;
  
    flex-direction: column;
  
    width: 100%;
  
    height: 100%;
  
    min-width: 0;
  
    min-height: 0;
  
    max-height: 100%;
  
    overflow: hidden;
  
  }
  
  
  
  .toolbar {
  
    flex: 0 0 auto;
  
    min-width: 0;
  
    min-height: 39px;
  
    flex-wrap: nowrap;
  
  }
  
  
  
  .toolbarGroup {
  
    flex: 0 0 auto;
  
    flex-wrap: nowrap;
  
  }
  
  
  
  .body {
  
    flex: 1 1 0;
  
    min-width: 0;
  
    min-height: 0;
  
    overflow: hidden;
  
  }
  
  
  
  .rail {
  
    flex: 0 0 39px;
  
    min-width: 39px;
  
  }
  
  
  
  .explorer {
  
    flex: 0 0 225px;
  
    width: 225px;
  
    min-width: 190px;
  
    min-height: 0;
  
  }
  
  
  
  .mainPane {
  
    flex: 1 1 0;
  
    width: 0;
  
    min-width: 0;
  
    min-height: 0;
  
    overflow: hidden;
  
  }
  
  
  
  .tabs {
  
    display: flex;
  
    flex: 0 0 36px;
  
    align-items: stretch;
  
    width: 100%;
  
    height: 36px;
  
    min-width: 0;
  
    min-height: 36px;
  
    overflow-x: auto;
  
    overflow-y: hidden;
  
    white-space: nowrap;
  
    scrollbar-width: thin;
  
  }
  
  
  
  .tab {
  
    flex: 0 0 auto;
  
    max-width: 220px;
  
    min-width: max-content;
  
    white-space: nowrap;
  
  }
  
  
  
  .workspaceContent {
  
    flex: 1 1 0;
  
    min-width: 0;
  
    min-height: 0;
  
    overflow: hidden;
  
  }
  
  
  
  .editorHeader,
  
  .resultsHeader {
  
    flex: 0 0 auto;
  
  }
  
  
  
  .editorArea {
  
    flex: 1 1 0;
  
    min-width: 0;
  
    min-height: 100px;
  
  }
  
  
  
  .results {
  
    flex: 0 1 38%;
  
    min-height: 145px;
  
    max-height: 48%;
  
  }
  
  
  
  .tableViewport,
  
  .panelContent,
  
  .chartPanel,
  
  .consoleOutput {
  
    min-width: 0;
  
    min-height: 0;
  
  }
  
  
  
  @media (max-width: 1100px) {
  
    .explorer {
  
      flex-basis: 205px;
  
      width: 205px;
  
    }
  
  }
  
  
  
  @media (max-width: 760px) {
  
    .toolbar {
  
      align-items: flex-start;
  
      flex-wrap: wrap;
  
    }
  
  
  
    .toolbarGroup {
  
      flex-wrap: wrap;
  
    }
  
  
  
    .explorer {
  
      flex-basis: 180px;
  
      width: 180px;
  
      min-width: 160px;
  
    }
  
  
  
    .results {
  
      flex-basis: 45%;
  
    }
  
  }
  
  
  
  @media (max-width: 560px) {
  
    .rail {
  
      flex-basis: 34px;
  
      min-width: 34px;
  
      padding-right: 3px;
  
      padding-left: 3px;
  
    }
  
  
  
    .explorer {
  
      flex-basis: 150px;
  
      width: 150px;
  
      min-width: 140px;
  
    }
  
  }
  
  
  /* =========================================================
     DOCK EXPLORER — SCREEN LAYOUT REPAIR
     Keeps the left tool rail compact and gives the dataset tree
     enough width for readable upload instructions and names.
     ========================================================= */
  .workspace {
    height: 100%;
    height: 100dvh;
    min-height: 0;
    max-height: 100dvh;
    overflow: hidden;
  }
  .body {
    display: flex !important;
    flex: 1 1 0 !important;
    flex-direction: row !important;
    align-items: stretch;
    min-width: 0;
    min-height: 0;
    overflow: hidden !important;
  }
  .rail {
    display: flex !important;
    flex: 0 0 42px !important;
    width: 42px !important;
    min-width: 42px !important;
    flex-direction: column !important;
    align-items: center;
    gap: 5px;
    padding: 8px 5px;
    overflow: hidden;
  }
  .railButton {
    display: grid !important;
    place-items: center;
    flex: 0 0 30px;
    width: 30px !important;
    min-width: 30px;
    height: 30px;
    padding: 0 !important;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0 !important;
  }
  .railButton svg { flex: 0 0 auto; }
  .explorer {
    display: flex !important;
    flex: 0 0 258px !important;
    width: 258px !important;
    min-width: 225px !important;
    max-width: 320px;
    min-height: 0;
    overflow: hidden !important;
  }
  .panelHeading { flex: 0 0 34px; min-width: 0; white-space: nowrap; }
  .panelHeading > span { overflow: hidden; text-overflow: ellipsis; }
  .searchWrap { flex: 0 0 29px; min-width: 0; }
  .tree { flex: 1 1 0; min-width: 0; overflow: auto; }
  .uploadDock { flex: 0 0 auto; min-width: 0; overflow: hidden; }
  .uploadDock :global(.dock-dropzone) {
    display: grid !important;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: center;
    gap: 9px;
    width: 100%;
    min-width: 0;
    min-height: 76px;
    padding: 10px;
  }
  .uploadDock :global(.dock-drop-icon) {
    width: 32px;
    height: 32px;
    margin: 0;
  }
  .uploadDock :global(.dock-drop-copy) {
    display: flex;
    min-width: 0;
    width: auto;
    flex-direction: column;
    gap: 3px;
    overflow-wrap: normal;
    word-break: normal;
  }
  .uploadDock :global(.dock-drop-copy strong),
  .uploadDock :global(.dock-drop-copy span),
  .uploadDock :global(.dock-drop-copy small) {
    word-break: normal;
    overflow-wrap: anywhere;
  }
  .uploadDock :global(.dock-dropzone > .dock-action-secondary) {
    grid-column: 2;
    justify-self: start;
    margin: 0;
    white-space: nowrap;
  }
  .mainPane {
    display: flex !important;
    flex: 1 1 0 !important;
    width: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden !important;
  }
  .tabs {
    display: flex !important;
    flex: 0 0 36px;
    flex-wrap: nowrap !important;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    height: 36px;
    overflow-x: auto !important;
    overflow-y: hidden;
    white-space: nowrap;
  }
  .tab {
    display: flex !important;
    flex: 0 0 auto !important;
    align-items: center;
    min-width: 94px;
    max-width: 190px;
    white-space: nowrap;
  }
  .tab > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .tab button {
    display: grid !important;
    flex: 0 0 18px;
    place-items: center;
    width: 18px;
    min-width: 18px;
    height: 18px;
    padding: 0;
    font-size: 0;
  }
  .tabAdd {
    display: flex !important;
    flex: 0 0 auto !important;
    align-items: center;
    justify-content: center;
    min-width: 68px;
    padding: 0 10px;
    white-space: nowrap;
  }
  .workspaceContent { flex: 1 1 0 !important; min-width: 0; min-height: 0; overflow: hidden !important; }
  .editorArea { flex: 1 1 0; min-height: 120px; min-width: 0; }
  .results { flex: 0 1 38%; min-height: 145px; max-height: 48%; }
  @media (max-width: 900px) {
    .explorer { flex-basis: 230px !important; width: 230px !important; min-width: 210px !important; }
  }
  @media (max-width: 650px) {
    .rail { flex-basis: 38px !important; width: 38px !important; min-width: 38px !important; }
    .explorer { flex-basis: 205px !important; width: 205px !important; min-width: 190px !important; }
  }
  