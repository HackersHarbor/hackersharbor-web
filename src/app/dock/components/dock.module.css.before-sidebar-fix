  :global(.dock-dataset-name) {

    display: flex;

    min-width: 0;

    flex-direction: column;

    gap: 3px;

  }

  :global(.dock-dataset-name) strong {

    overflow: hidden;

    color: var(--text);

    font-size: 10px;

    font-weight: 600;

    text-overflow: ellipsis;

    white-space: nowrap;

  }

