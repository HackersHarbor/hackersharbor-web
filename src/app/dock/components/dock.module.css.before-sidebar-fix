  /* =========================================================

     SCROLLBARS

     ========================================================= */

  .studio * {

    scrollbar-width: thin;

    scrollbar-color: #555555 #222222;

  }

  .studio *::-webkit-scrollbar {

    width: 9px;

    height: 9px;

  }

  .studio *::-webkit-scrollbar-track {

    background: #222222;

  }

  .studio *::-webkit-scrollbar-thumb {

    border: 2px solid #222222;

    border-radius: 4px;

    background: #555555;

  }

  .studio *::-webkit-scrollbar-thumb:hover {

    background: #707070;

  }

