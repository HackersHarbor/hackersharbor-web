      max-height: 55vh;

    }

  }

  @media (max-width: 480px) {

    .brandName {

      font-size: 10px;

    }

    .brandProduct {

      font-size: 7px;

    }

    .brandMark {

      width: 25px;

      height: 25px;

    }

    .topbarActions {

      gap: 2px;

    }

    .breadcrumbBar {

      min-height: 34px;

    }

    .breadcrumbActions .subtleButton {

      width: 29px;

      overflow: hidden;

      padding: 0;

      font-size: 0;

    }

    .breadcrumbActions .subtleButton svg {

      flex-shrink: 0;

    }

    .pageContent {

      padding: 12px 8px 20px;

