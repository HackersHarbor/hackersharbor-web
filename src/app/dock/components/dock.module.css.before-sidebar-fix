  :global(.dock-quality-metric) > span {

    color: var(--muted);

    font-size: 9px;

  }

  :global(.dock-quality-metric) > strong {

    overflow-wrap: anywhere;

    color: var(--text);

    font-size: 17px;

    font-weight: 600;

  }

  :global(.dock-quality-metric) > small {

    color: var(--subtle);

    font-size: 9px;

    line-height: 1.5;

  }

  :global(.dock-quality-note) {

    display: flex;

    align-items: flex-start;

    gap: 7px;

    margin: 0 9px 10px;

