  :global(.dock-pagination) {

    display: flex;

    align-items: center;

    gap: 7px;

  }

  :global(.dock-pagination) > span {

    min-width: 38px;

    text-align: center;

  }

  :global(.dock-explorer-inspector) {

    display: flex;

    flex-direction: column;

    gap: 9px;

  }

  :global(.dock-side-panel-heading) {

    align-items: flex-start;

  }

  :global(.dock-schema-list) {

    padding: 4px 9px 8px;

  }

  :global(.dock-schema-item) {

    display: flex;

    align-items: center;

    gap: 7px;

    min-width: 0;

    padding: 8px 3px;

    border-bottom: 1px solid var(--border);

  }

  :global(.dock-schema-item):last-child {

    border-bottom: 0;

  }

  :global(.dock-schema-index) {

    color: var(--subtle);

    font-size: 9px;

    font-variant-numeric: tabular-nums;

  }

  :global(.dock-schema-name) {

    display: flex;

    flex: 1;

    min-width: 0;

    flex-direction: column;

    gap: 3px;

  }

  :global(.dock-schema-name) strong {

    overflow-wrap: anywhere;

    color: var(--text);

    font-size: 10px;

    font-weight: 500;

  }

  :global(.dock-schema-name) small {

    color: var(--muted);

    font-size: 9px;

  }

  :global(.dock-type-badge) {

    padding: 3px 5px;

    color: #bdbdbd;

    border: 1px solid var(--border);

    border-radius: 3px;

    background: #303030;

    font-size: 9px;

  }

  :global(.dock-quality-grid) {

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 6px;

    padding: 9px;

  }

  :global(.dock-quality-metric) {

    display: flex;

    min-width: 0;

    flex-direction: column;

    gap: 5px;

    padding: 9px 7px;

    border: 1px solid var(--border);

    border-radius: 3px;

    background: #202020;

