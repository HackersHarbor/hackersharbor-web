/* =========================================================

   HACKERSHARBOR DOCK STUDIO

   Dark database IDE theme

   ========================================================= */

   .studio {

    --bg: #1e1e1e;

    --panel: #252526;

    --panel-solid: #1e1e1e;

    --panel-raised: #2d2d2d;

    --panel-hover: #333333;

    --border: #383838;

    --border-strong: #505050;

    --text: #d4d4d4;

    --muted: #a0a0a0;

    --subtle: #777777;

    --accent: #29b77a;

    --accent-strong: #21865e;

    --accent-soft: rgba(41, 183, 122, 0.12);

    --success: #29b77a;

    --danger: #f87171;

    --warning: #e5b567;

    --code: #181818;

    position: relative;

    isolation: isolate;

    display: flex;

    flex-direction: column;

    width: 100%;

    min-height: 100vh;

    overflow: hidden;

    color: var(--text);

    background: var(--bg);

    font-family: Inter, "Segoe UI", Arial, sans-serif;

    font-size: 12px;

    line-height: 1.45;

  }

  .studio,

  .studio * {

    box-sizing: border-box;

  }

  .studio button,

  .studio input,

  .studio select,

  .studio textarea {

    font: inherit;

  }

  .studio button {

    color: inherit;

  }

  .studio button:focus-visible,

  .studio input:focus-visible,

  .studio select:focus-visible,

  .studio textarea:focus-visible {

    outline: 1px solid var(--accent);

    outline-offset: 2px;

  }

  .ambient {

    position: absolute;

    z-index: -1;

    inset: 0;

    pointer-events: none;

    background: radial-gradient(

      ellipse at 50% 0%,

      rgba(255, 255, 255, 0.025),

      transparent 60%

    );

  }

  /* =========================================================

     TOP TOOLBAR

     ========================================================= */

  .topbar {

    position: relative;

    z-index: 5;

    display: flex;

    align-items: center;

    justify-content: space-between;

    min-height: 43px;

    gap: 12px;

    padding: 0 12px;

    border-bottom: 1px solid var(--border);

    background: #252526;

  }

  .brandArea,

  .topbarActions,

  .brandText,

  .projectButton,

  .searchButton,

  .runtimeBadge,

  .breadcrumbBar,

  .breadcrumbs,

  .breadcrumbActions,

  .headingActions,

  .metricTop {

    display: flex;

    align-items: center;

  }

  .brandArea {

    min-width: 0;

    gap: 9px;

  }

  .brandMark {

    display: grid;

    place-items: center;

    width: 27px;

    height: 27px;

    flex-shrink: 0;

    color: #d4d4d4;

    border: 1px solid #484848;

    border-radius: 5px;

    background: #303030;

    box-shadow: none;

  }

  .brandText {

    align-items: flex-start;

    flex-direction: column;

    gap: 1px;

    white-space: nowrap;

  }

  .brandName {

    font-size: 12px;

    font-weight: 650;

    letter-spacing: -0.2px;

  }

  .brandProduct {

    color: var(--muted);

    font-size: 8px;

    font-weight: 700;

    letter-spacing: 1.3px;

  }

  .brandDivider {

    width: 1px;

    height: 23px;

    margin: 0 5px;

    background: var(--border-strong);

  }

  .projectButton {

    min-width: 0;

    gap: 7px;

    padding: 6px 8px;

    color: var(--muted);

    border: 1px solid transparent;

    border-radius: 4px;

    background: transparent;

    cursor: pointer;

    white-space: nowrap;

  }

  .projectButton:hover,

  .iconButton:hover,

  .subtleButton:hover,

  .secondaryButton:hover {

    color: var(--text);

    border-color: var(--border-strong);

    background: var(--panel-raised);

  }

  .topbarActions {

    gap: 6px;

  }

  .iconButton {

    display: grid;

    place-items: center;

    width: 29px;

    height: 29px;

    flex-shrink: 0;

    color: var(--muted);

    border: 1px solid transparent;

    border-radius: 4px;

    background: transparent;

    cursor: pointer;

  }

  .searchButton {

    gap: 8px;

    width: min(250px, 24vw);

    min-width: 130px;

    padding: 6px 9px;

    color: var(--muted);

    border: 1px solid var(--border);

    border-radius: 4px;

    background: #1e1e1e;

    cursor: pointer;

    text-align: left;

  }

  .searchButton span {

    flex: 1;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

  }

  .searchButton kbd {

    padding: 1px 4px;

    color: var(--subtle);

    border: 1px solid var(--border);

    border-radius: 3px;

    font-size: 9px;

    white-space: nowrap;

  }

  .runtimeBadge {

    gap: 6px;

    padding: 5px 8px;

    color: var(--muted);

    border: 1px solid var(--border);

    border-radius: 4px;

    font-size: 10px;

    white-space: nowrap;

  }

  .statusDot {

    width: 6px;

    height: 6px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--success);

  }

  .avatar {

    display: grid;

    place-items: center;

    width: 27px;

    height: 27px;

    color: var(--text);

    border: 1px solid var(--border-strong);

    border-radius: 50%;

    background: #343434;

    font-size: 11px;

    font-weight: 700;

  }

  /* =========================================================

     WORKSPACE AND NAVIGATION

     ========================================================= */

  .workspace {

    display: flex;

    flex: 1;

    min-height: calc(100vh - 43px);

    min-width: 0;

  }

  .sidebar {

    position: relative;

    display: flex;

    flex: 0 0 205px;

    flex-direction: column;

    justify-content: space-between;

    width: 205px;

    min-height: 0;

    border-right: 1px solid var(--border);

    background: #252526;

    transition: width 160ms ease, flex-basis 160ms ease;

  }

  .sidebarCollapsed {

    flex-basis: 48px;

    width: 48px;

  }

  .sidebarTop {

    display: flex;

    flex-direction: column;

    gap: 2px;

    padding: 15px 8px 8px;

  }

  .sectionEyebrow {

    color: var(--subtle);

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 1.1px;

  }

  .sidebarTop > .sectionEyebrow {

    padding: 0 9px 7px;

  }

  .groupLabel {

    margin-top: 20px;

  }

  .navItem {

    display: flex;

    align-items: center;

    min-height: 31px;

    gap: 9px;

    padding: 0 9px;

    color: var(--muted);

    border: 1px solid transparent;

    border-radius: 4px;

    background: transparent;

    cursor: pointer;

    text-align: left;

    transition: color 100ms ease, background 100ms ease;

  }

  .navItem span:nth-child(2) {

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

  }

  .navItem:hover {

    color: var(--text);

    background: #303030;

  }

  .navItemActive {

    color: #e6e6e6;

    border-color: #414141;

    background: #333333;

    font-weight: 600;

  }

  .navItemActive svg {

    color: var(--accent);

  }

  .sidebarCollapsed .navItem {

    justify-content: center;

    padding: 0;

  }

  .navCount {

    margin-left: auto;

    color: var(--subtle);

    font-size: 10px;

  }

  .sidebarSpacer {

    flex: 1;

    min-height: 24px;

  }

  .sidebarFooter {

    display: flex;

    align-items: center;

    gap: 9px;

    margin: 9px;

    padding: 10px 8px;

    border: 1px solid var(--border);

    border-radius: 5px;

    background: #202020;

  }

  .helpIcon,

  .panelHeaderIcon,

  .metricIcon,

  .workflowIcon,

  .searchResultIcon {

    display: grid;

    place-items: center;

    flex-shrink: 0;

    color: var(--muted);

    border: 1px solid var(--border);

    border-radius: 5px;

    background: #303030;

  }

  .helpIcon {

    width: 27px;

    height: 27px;

  }

  .helpText {

    display: flex;

    flex: 1;

    min-width: 0;

    flex-direction: column;

    gap: 3px;

  }

  .helpText strong {

    font-size: 10px;

    font-weight: 600;

  }

  .helpText span {

    color: var(--muted);

    font-size: 9px;

  }

  .mutedIcon {

    color: var(--subtle);

  }

  .mainPanel {

    flex: 1;

    min-width: 0;

    min-height: 0;

  }

  /* =========================================================

     BREADCRUMBS AND PAGE HEADING

     ========================================================= */

  .breadcrumbBar {

    justify-content: space-between;

    min-height: 37px;

    gap: 12px;

    padding: 0 16px;

    border-bottom: 1px solid var(--border);

    background: #202020;

  }

  .breadcrumbs {

    gap: 8px;

    color: var(--muted);

    font-size: 10px;

  }

  .breadcrumbSlash {

    color: var(--subtle);

  }

  .breadcrumbs strong {

    color: var(--text);

    font-weight: 600;

  }

  .breadcrumbActions {

    gap: 10px;

  }

  .savedIndicator {

    display: flex;

    align-items: center;

    gap: 6px;

    color: var(--muted);

    font-size: 9px;

    white-space: nowrap;

  }

  .subtleButton,

  .secondaryButton,

  .primaryButton,

  .welcomeButton {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 29px;

    padding: 0 9px;

    border: 1px solid var(--border);

    border-radius: 4px;

    cursor: pointer;

    font-size: 10px;

    font-weight: 600;

    transition: background 100ms ease, border-color 100ms ease;

  }

  .subtleButton {

    color: var(--muted);

    background: transparent;

  }

  .secondaryButton {

    color: var(--text);

    background: #292929;

  }

  .primaryButton,

  .welcomeButton {

    color: #e5e5e5;

    border-color: #505050;

    background: #383838;

    box-shadow: none;

  }

  .primaryButton:hover:not(:disabled),

  .welcomeButton:hover {

    background: #454545;

  }

  .primaryButton:disabled,

  .secondaryButton:disabled,

  .subtleButton:disabled {

    opacity: 0.45;

    cursor: not-allowed;

  }

  .pageContent {

    width: 100%;

    min-width: 0;

    margin: 0;

    padding: 18px 18px 28px;

  }

  .pageHeading {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 18px;

    margin-bottom: 17px;

  }

  .pageEyebrow {

    margin-bottom: 6px;

    color: var(--subtle);

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 1.2px;

  }

  .pageEyebrow span {

    padding: 0 4px;

    color: var(--accent);

  }

  .pageHeading h1 {

    margin: 0;

    font-size: 20px;

    font-weight: 600;

    letter-spacing: -0.45px;

    line-height: 1.3;

  }

  .pageHeading p {

    max-width: 650px;

    margin: 5px 0 0;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.6;

  }

  .headingActions {

    flex-shrink: 0;

    gap: 7px;

  }

  /* =========================================================

     LEGACY OVERVIEW COMPONENTS

     Kept for the existing OverviewContent component.

     ========================================================= */

  .welcomeBanner {

    position: relative;

    display: flex;

    min-height: 190px;

    overflow: hidden;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding: 25px;

    border: 1px solid var(--border);

    border-radius: 5px;

    background: #252526;

  }

  .welcomeCopy {

    position: relative;

    z-index: 2;

    max-width: 540px;

  }

  .welcomeLabel {

    color: var(--accent);

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 1.3px;

  }

  .welcomeCopy h2 {

    margin: 10px 0 7px;

    font-size: 23px;

    font-weight: 600;

    letter-spacing: -0.6px;

    line-height: 1.3;

  }

  .welcomeCopy p {

    max-width: 450px;

    margin: 0 0 17px;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.7;

  }

  .welcomeVisual {

    position: relative;

    width: 200px;

    height: 160px;

    flex: 0 0 200px;

  }

  .visualOrbit,

  .visualOrbitInner {

    position: absolute;

    top: 50%;

    left: 50%;

    border: 1px solid #414141;

    border-radius: 50%;

    transform: translate(-50%, -50%);

  }

  .visualOrbit {

    width: 150px;

    height: 150px;

  }

  .visualOrbitInner {

    width: 105px;

    height: 105px;

  }

  .visualCore {

    position: absolute;

    top: 50%;

    left: 50%;

    display: grid;

    place-items: center;

    width: 57px;

    height: 57px;

    color: var(--accent);

    border: 1px solid #505050;

    border-radius: 10px;

    background: #303030;

    transform: translate(-50%, -50%);

  }

  .visualNode {

    position: absolute;

    display: grid;

    place-items: center;

    width: 30px;

    height: 30px;

    color: var(--muted);

    border: 1px solid #505050;

    border-radius: 6px;

    background: #303030;

  }

  .nodeOne {

    top: 8px;

    left: 85px;

  }

  .nodeTwo {

    right: 5px;

    bottom: 28px;

  }

  .nodeThree {

    bottom: 8px;

    left: 27px;

  }

  .metricsGrid {

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 9px;

    margin-top: 12px;

  }

  .metricCard {

    min-width: 0;

    padding: 13px;

    border: 1px solid var(--border);

    border-radius: 5px;

    background: var(--panel);

  }

  .metricTop {

    justify-content: space-between;

    gap: 8px;

    color: var(--muted);

    font-size: 10px;

  }

  .metricIcon {

    width: 27px;

    height: 27px;

  }

  .metricCard > strong {

    display: block;

    margin-top: 9px;

    font-size: 21px;

    font-weight: 600;

    letter-spacing: -0.3px;

  }

  .metricCard > p {

    margin: 5px 0 0;

    overflow-wrap: anywhere;

    color: var(--subtle);

    font-size: 9px;

    line-height: 1.5;

  }

  .metricReady {

    color: var(--success);

    font-size: 17px !important;

    letter-spacing: 0 !important;

  }

  .contentGrid {

    display: grid;

    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);

    gap: 11px;

    margin-top: 12px;

  }

  .panel {

    min-width: 0;

    padding: 15px;

    border: 1px solid var(--border);

    border-radius: 5px;

    background: var(--panel);

  }

  .panelHeader {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 12px;

  }

  .panelHeader h3,

  .capabilitiesHeading h3 {

    margin: 0;

    font-size: 12px;

    font-weight: 600;

  }

  .panelHeader p {

    margin: 5px 0 0;

    color: var(--muted);

    font-size: 10px;

    line-height: 1.5;

  }

  .panelHeaderIcon {

    width: 28px;

    height: 28px;

  }

  .workflowList {

    display: flex;

    flex-direction: column;

    gap: 3px;

    margin-top: 13px;

  }

  .workflowItem {

    display: flex;

    align-items: center;

    gap: 10px;

    width: 100%;

    min-width: 0;

    padding: 9px 5px;

    border: 1px solid transparent;

    border-radius: 4px;

    background: transparent;

    cursor: pointer;

    text-align: left;

  }

  .workflowItem:hover {

    border-color: var(--border);

    background: var(--panel-raised);

  }

  .workflowNumber {

    color: var(--subtle);

    font-size: 9px;

    font-variant-numeric: tabular-nums;

  }

  .workflowIcon {

    width: 30px;

    height: 30px;

  }

  .workflowText {

    display: flex;

    flex: 1;

    min-width: 0;

    flex-direction: column;

    gap: 4px;

  }

  .workflowText strong {

    color: var(--text);

    font-size: 10px;

    font-weight: 600;

  }

  .workflowText small {

    color: var(--muted);

    font-size: 9px;

    line-height: 1.6;

  }

  .workflowArrow {

    color: var(--subtle);

    font-size: 14px;

  }

  .workflowItem:hover .workflowArrow {

    color: var(--accent);

  }

  .activityEmpty {

    display: flex;

    min-height: 190px;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    padding: 16px 10px;

    text-align: center;

  }

  .activityGlyph {

    display: grid;

    place-items: center;

    width: 40px;

    height: 40px;

    margin-bottom: 12px;

    color: var(--muted);

    border: 1px solid var(--border);

    border-radius: 8px;

    background: #2b2b2b;

  }

  .activityEmpty strong {

    font-size: 11px;

    font-weight: 600;

  }

  .activityEmpty p {

    max-width: 290px;

    margin: 7px 0 10px;

    color: var(--muted);

    font-size: 10px;

    line-height: 1.7;

  }

  .textButton {

    padding: 5px;

    color: var(--accent);

    border: 0;

    background: transparent;

    cursor: pointer;

    font-size: 10px;

    font-weight: 600;

  }

  .capabilitiesPanel {

    margin-top: 12px;

    padding: 15px;

    border: 1px solid var(--border);

    border-radius: 5px;

    background: var(--panel);

  }

  .capabilitiesHeading .sectionEyebrow {

    display: block;

    margin-bottom: 7px;

  }

  .capabilitiesGrid {

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 8px;

    margin-top: 13px;

  }

  .capability {

    display: flex;

    min-width: 0;

    min-height: 105px;

    align-items: flex-start;

    flex-direction: column;

    padding: 11px;

    border: 1px solid var(--border);

    border-radius: 4px;

    background: #222222;

    cursor: pointer;

    text-align: left;

  }

  .capability:hover {

    border-color: #5b5b5b;

    background: #2b2b2b;

  }

  .capability > strong {

    font-size: 10px;

    font-weight: 600;

  }

  .capability > span:nth-child(2) {

    margin-top: 7px;

    color: var(--muted);

    font-size: 9px;

    line-height: 1.6;

  }

  .capabilityArrow {

    margin-top: auto;

    padding-top: 10px;

    color: var(--accent);

    font-size: 9px;

    font-weight: 600;

  }

  /* =========================================================

     FEATURE PLACEHOLDER

     ========================================================= */

  .featureLanding {

    display: flex;

    min-height: 340px;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    padding: 25px;

    border: 1px solid var(--border);

    border-radius: 5px;

    background: var(--panel);

    text-align: center;

  }

  .featureIcon {

    display: grid;

    place-items: center;

    width: 53px;

    height: 53px;

    margin-bottom: 18px;

    color: var(--accent);

    border: 1px solid var(--border-strong);

    border-radius: 8px;

    background: #303030;

  }

  .featureLanding > .sectionEyebrow {

    margin-bottom: 10px;

  }

  .featureLanding h2 {

    margin: 0;

    font-size: 22px;

    font-weight: 600;

    letter-spacing: -0.4px;

  }

  .featureLanding > p {

    max-width: 500px;

    margin: 10px 0 18px;

    color: var(--muted);

    font-size: 11px;

    line-height: 1.8;

  }

  .comingSoon {

    padding: 6px 9px;

    color: var(--muted);

    border: 1px solid var(--border);

    border-radius: 4px;

    background: #292929;

    font-size: 9px;

  }

  .featureFootnote {

    margin-top: 25px;

    color: var(--subtle);

    font-size: 9px;

  }

  /* =========================================================

     SEARCH DIALOG

     ========================================================= */

  .modalBackdrop {

    position: fixed;

    z-index: 20;

    inset: 0;

    display: flex;

    align-items: flex-start;

    justify-content: center;

    padding: 12vh 18px 18px;

    background: rgba(0, 0, 0, 0.65);

    backdrop-filter: blur(3px);

  }

  .searchDialog {

    width: min(560px, 100%);

    overflow: hidden;

    border: 1px solid var(--border-strong);

    border-radius: 6px;

    background: var(--panel-solid);

    box-shadow: 0 18px 65px rgba(0, 0, 0, 0.45);

  }

  .searchInputRow {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 12px;

    color: var(--muted);

    border-bottom: 1px solid var(--border);

  }

  .searchInputRow input {

    flex: 1;

    min-width: 0;

    color: var(--text);

    border: 0;

    outline: 0;

    background: transparent;

    font-size: 12px;

  }

  .searchInputRow input::placeholder {

    color: var(--subtle);

  }

  .searchResults {

    display: flex;

    max-height: 360px;

    flex-direction: column;

    gap: 3px;

    overflow-y: auto;

    padding: 11px;

  }

  .searchResults > .sectionEyebrow {

    padding: 4px 6px 7px;

  }

  .searchResult {

    display: flex;

    align-items: center;

    gap: 10px;

    width: 100%;

    padding: 8px;

    border: 1px solid transparent;

    border-radius: 4px;

    background: transparent;

    cursor: pointer;

    text-align: left;

  }

  .searchResult:hover {

    border-color: var(--border);

    background: var(--panel-raised);

  }

  .searchResultIcon {

    width: 29px;

    height: 29px;

  }

  .searchResultText {

    display: flex;

    flex: 1;

    min-width: 0;

    flex-direction: column;

    gap: 3px;

  }

  .searchResultText strong {

    color: var(--text);

    font-size: 10px;

    font-weight: 600;

  }

