  :global(.dock-dataset-remove):hover {

    color: var(--danger) !important;

  }

  :global(.dock-empty-list),

  :global(.dock-table-empty),

  :global(.dock-panel-empty) {

    display: flex;

    min-height: 130px;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    gap: 8px;

    padding: 16px;

