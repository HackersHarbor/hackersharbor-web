  :global(.dock-data-table) th,

  :global(.dock-data-table) td {

    max-width: 240px;

    overflow: hidden;

    padding: 8px 10px;

    border-bottom: 1px solid var(--border);

    text-overflow: ellipsis;

    white-space: nowrap;

