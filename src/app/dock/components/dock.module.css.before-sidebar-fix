      padding: 11px;

    }

    .workflowItem {

      gap: 7px;

      padding: 8px 2px;

    }

    .workflowNumber {

      display: none;

    }

    .workflowText small {

      font-size: 9px;

    }

    .capabilitiesGrid {

      grid-template-columns: 1fr;

