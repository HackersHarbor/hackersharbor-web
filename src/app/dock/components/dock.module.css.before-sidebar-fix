  :global(.dock-preview-toolbar) {

    align-items: center;

    flex-wrap: wrap;

  }

  :global(.dock-preview-toolbar) > div {

    display: flex;

    flex-direction: column;

    gap: 4px;

  }

  :global(.dock-preview-toolbar) > div strong {

    font-size: 10px;

    font-weight: 600;

  }

  :global(.dock-preview-toolbar) > div span {

    color: var(--muted);

    font-size: 9px;

  }

  :global(.dock-table-search) {

