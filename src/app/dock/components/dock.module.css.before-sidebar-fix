  :global(.dock-data-table) :global(.dock-row-index) {

    width: 38px;

    color: var(--subtle);

    background: #222222;

    text-align: right;

  }

  :global(.dock-null-value) {

    color: var(--subtle);

    font-style: italic;

  }

  :global(.dock-no-results) {

    padding: 25px !important;

    color: var(--muted) !important;

    text-align: center;

  }

  :global(.dock-table-footer) {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    padding: 8px 10px;

    color: var(--muted);

    border-top: 1px solid var(--border);

    font-size: 9px;

