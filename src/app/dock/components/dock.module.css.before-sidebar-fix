    position: sticky;

    top: 0;

    z-index: 1;

    color: #b5b5b5;

    background: #2a2a2a;

    font-size: 9px;

    font-weight: 600;

  }

  :global(.dock-data-table) td {

    color: var(--text);

    font-variant-numeric: tabular-nums;

  }

  :global(.dock-data-table) tbody tr:hover td {

    background: #2b302e;

