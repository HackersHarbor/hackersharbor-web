"use client";

import { useMemo, useState } from "react";

import {

  Activity,

  Bell,

  BookOpen,

  ChevronDown,

  Database,

  FileCode2,

  FolderKanban,

  LayoutDashboard,

  Menu,

  Moon,

  Plus,

  Search,

  Settings2,

  Sun,

  X,

} from "lucide-react";

import { DOCK_NAVIGATION } from "../constants/navigation";

import type { StudioSection } from "../types/navigation";

import styles from "./dock.module.css";

import DataExplorer from "../features/explorer/DataExplorer";
import { useDatasets } from "../hooks/useDatasets";
import DockSidebar from "./DockSidebar";

import OverviewContent from "./OverviewContent";
const iconMap = {

  overview: LayoutDashboard,

  explorer: Database,

  notebooks: FileCode2,

  statistics: Activity,

  "machine-learning": Activity,

  "deep-learning": Activity,

  "ai-evaluation": BookOpen,

  settings: Settings2,

};

const sectionDescriptions: Record<StudioSection, string> = {

  overview: "Your data work, experiments, and recent activity.",

  explorer: "Inspect datasets, understand schemas, and validate data quality.",

  notebooks: "Explore data with executable Python and SQL notebooks.",

  statistics: "Understand distributions, relationships, and statistical evidence.",

  "machine-learning": "Build, compare, and evaluate machine-learning models.",

  "deep-learning": "Track training runs, model behavior, and experiments.",

  "ai-evaluation": "Evaluate model responses against measurable criteria.",

  settings: "Configure your Dock workspace preferences.",

};

export default function DockStudio() {

  const { datasets } = useDatasets();

  const [activeSection, setActiveSection] =

    useState<StudioSection>("explorer");

  const [sidebarCollapsed, setSidebarCollapsed] = useState(true);
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);

  const [theme, setTheme] = useState<"dark" | "light">("dark");

  const [searchOpen, setSearchOpen] = useState(false);

  const [searchQuery, setSearchQuery] = useState("");

  const activeItem = useMemo(

    () => DOCK_NAVIGATION.find((item) => item.id === activeSection),

    [activeSection],

  );

  const filteredNavigation = useMemo(() => {

    const query = searchQuery.trim().toLowerCase();

    if (!query) return DOCK_NAVIGATION;

    return DOCK_NAVIGATION.filter(

      (item) =>

        item.label.toLowerCase().includes(query) ||

        item.description.toLowerCase().includes(query),

    );

  }, [searchQuery]);

  function navigate(section: StudioSection) {

    setActiveSection(section);

    // Keep the main navigation compact while entering the Data Explorer workspace.

    // Other Dock sections expand it so their labels remain easy to scan.

    setSidebarCollapsed(section === "explorer");
    setMobileSidebarOpen(false);

    setSearchOpen(false);

    setSearchQuery("");

  }

  return (

    <main

      className={styles.studio}

      data-theme={theme}

      style={{ display: "flex", flexDirection: "column", width: "100%", height: "100dvh", minHeight: 0, overflow: "hidden" }}

    >

      <div className={styles.ambient} aria-hidden="true" />

      <header className={styles.topbar}>

        <div className={styles.brandArea}>

          <button

            type="button"

            className={styles.iconButton}

            onClick={() => {
              if (typeof window !== "undefined" && window.matchMedia("(max-width: 760px)").matches) {
                setMobileSidebarOpen(true);
              } else {
                setSidebarCollapsed((value) => !value);
              }
            }}

            aria-label="Toggle navigation"

            title="Toggle navigation"

          >

            <Menu size={17} />

          </button>

          <div className={styles.brandMark}>

            <Database size={18} strokeWidth={1.8} />

          </div>

          <div className={styles.brandText}>

            <span className={styles.brandName}>HackersHarbor</span>

            <span className={styles.brandProduct}>DOCK ANALYTICS</span>

          </div>

          <span className={styles.brandDivider} />

          <button type="button" className={styles.projectButton}>

            <FolderKanban size={14} />

            <span>Personal workspace</span>

            <ChevronDown size={13} />

          </button>

        </div>

        <div className={styles.topbarActions}>

          <button

            type="button"

            className={styles.searchButton}

            onClick={() => setSearchOpen((value) => !value)}

            aria-label="Search workspace"

          >

            <Search size={14} />

            <span>Search workspace</span>

            <kbd>Ctrl K</kbd>

          </button>

<button

            type="button"

            className={styles.iconButton}

            aria-label="Notifications"

            title="Notifications"

          >

            <Bell size={16} />

          </button>

          <button

            type="button"

            className={styles.iconButton}

            aria-label={`Switch to ${theme === "dark" ? "light" : "dark"} theme`}

            onClick={() =>

              setTheme((value) => (value === "dark" ? "light" : "dark"))

            }

          >

            {theme === "dark" ? <Sun size={16} /> : <Moon size={16} />}

          </button>

          <div className={styles.avatar} title="Your workspace">

            H

          </div>

        </div>

      </header>

      <div

          className={styles.workspace}

          style={{ display: "flex", flex: "1 1 0", width: "100%", minWidth: 0, minHeight: 0, alignItems: "stretch", overflow: "hidden" }}

        >

        <DockSidebar
          activeSection={activeSection}
          collapsed={sidebarCollapsed}
          onToggleCollapsed={() => setSidebarCollapsed((value) => !value)}
          onNavigate={navigate}
          mobileOpen={mobileSidebarOpen}
          onCloseMobile={() => setMobileSidebarOpen(false)}
          datasetsCount={datasets.length}
          notebooksCount={0}
          accountName="Personal account"
          accountInitials="H"
        />

        <section

          className={styles.mainPanel}

          style={{ display: "flex", flex: "1 1 0", flexDirection: "column", minWidth: 0, minHeight: 0, overflow: "hidden" }}

        >

          <div

            className={styles.pageContent}

            style={{ display: "flex", flex: "1 1 0", flexDirection: "column", width: "100%", minWidth: 0, minHeight: 0, overflow: "hidden" }}

          >

            {activeSection !== "explorer" && (

              <div className={styles.pageHeading}>

              <div>

                <div className={styles.pageEyebrow}>

                  HACKERSHARBOR <span>/</span> DATA PLATFORM

                </div>

                <h1>{activeItem?.label ?? "Data Explorer"}</h1>

                <p>{sectionDescriptions[activeSection]}</p>

              </div>

              <div className={styles.headingActions}>

                <button

                  type="button"

                  className={styles.primaryButton}

                  onClick={() => navigate("notebooks")}

                >

                  <Plus size={15} />

                  Create notebook

                </button>

              </div>

            </div>

            )}

            {activeSection === "explorer" ? (

              <div

                className={styles.explorerHost}

                style={{ display: "flex", flex: "1 1 0", flexDirection: "column", width: "100%", minWidth: 0, minHeight: 0, overflow: "hidden" }}

              >

                <DataExplorer />

              </div>

            ) : activeSection === "overview" ? (

              <OverviewContent onNavigate={navigate} />

            ) : (

              <SectionPlaceholder

                section={activeSection}

                onNavigate={navigate}

              />

            )}

          </div>

        </section>

      </div>

      {searchOpen && (

        <div

          className={styles.modalBackdrop}

          onMouseDown={(event) => {

            if (event.target === event.currentTarget) setSearchOpen(false);

          }}

        >

          <section

            className={styles.searchDialog}

            aria-label="Workspace search"

          >

            <div className={styles.searchInputRow}>

              <Search size={17} />

              <input

                autoFocus

                value={searchQuery}

                onChange={(event) => setSearchQuery(event.target.value)}

                placeholder="Find a workspace or analytics section..."

                aria-label="Search workspace sections"

              />

              <button

                type="button"

                className={styles.iconButton}

                onClick={() => setSearchOpen(false)}

                aria-label="Close search"

              >

                <X size={16} />

              </button>

            </div>

            <div className={styles.searchResults}>

              <span className={styles.sectionEyebrow}>NAVIGATION</span>

              {filteredNavigation.length > 0 ? (

                filteredNavigation.map((item) => {

                  const Icon = iconMap[item.id];

                  return (

                    <button

                      type="button"

                      key={item.id}

                      className={styles.searchResult}

                      onClick={() => navigate(item.id)}

                    >

                      <span className={styles.searchResultIcon}>

                        <Icon size={15} />

                      </span>

                      <span className={styles.searchResultText}>

                        <strong>{item.label}</strong>

                        <small>{item.description}</small>

                      </span>

                      <span className={styles.searchEnter}>Open</span>

                    </button>

                  );

                })

              ) : (

                <p className={styles.emptySearch}>

                  No workspace sections match your search.

                </p>

              )}

            </div>

          </section>

        </div>

      )}

    </main>

  );

}

function SectionPlaceholder({

  section,

  onNavigate,

}: {

  section: StudioSection;

  onNavigate: (section: StudioSection) => void;

}) {

  const sectionCopy: Record<

    Exclude<StudioSection, "overview">,

    { title: string; description: string; icon: typeof Database }

  > = {

    explorer: {

      title: "Explore your data",

      description: "Import CSV files, inspect schemas, preview records, and review data quality.",

      icon: Database,

    },

    notebooks: {

      title: "A workspace for your ideas",

      description: "The notebook workspace will bring together Python, SQL, Markdown, cell outputs, and execution feedback.",

      icon: FileCode2,

    },

    statistics: {

      title: "Understand your data",

      description: "Analyze distributions, correlation, descriptive statistics, and statistical tests.",

      icon: Activity,

    },

    "machine-learning": {

      title: "Build and evaluate models",

      description: "Develop model training, evaluation, feature importance, and comparison workflows.",

      icon: Activity,

    },

    "deep-learning": {

      title: "Follow the training process",

      description: "Inspect training curves, experiment history, and model comparisons.",

      icon: Activity,

    },

    "ai-evaluation": {

      title: "Measure AI performance",

      description: "Compare prompts, benchmark datasets, and inspect evaluation results.",

      icon: BookOpen,

    },

    settings: {

      title: "Workspace settings",

      description: "Configure preferences and workspace behavior.",

      icon: Settings2,

    },

  };

  const content =

    sectionCopy[section as Exclude<StudioSection, "overview">];

  const Icon = content.icon;

  return (

    <section className={styles.featureLanding}>

      <div className={styles.featureIcon}>

        <Icon size={25} strokeWidth={1.5} />

      </div>

      <span className={styles.sectionEyebrow}>DOCK WORKSPACE</span>

      <h2>{content.title}</h2>

      <p>{content.description}</p>

      {section === "notebooks" ? (

  <div className={styles.activityEmpty}>

    <div className={styles.activityGlyph}>

      <FileCode2 size={20} />

    </div>

    <strong>No notebooks yet</strong>

    <p>

      Your notebooks will appear here when notebook creation is available.

      You will be able to organize Python, SQL, and Markdown analyses in this

      workspace.

    </p>

    <span className={styles.comingSoon}>

      Notebook creation is not connected yet

    </span>

  </div>

) : (

  <span className={styles.comingSoon}>Feature integration pending</span>

)}

      <div className={styles.featureFootnote}>

        This section will connect to its own implementation. No results are simulated.

      </div>

    </section>

  );

}

